# Teable 数据库连接配置（请替换为你自己的 Teable 资源 ID）
# 说明：本模板仓库不会提交真实的 .env 文件；部署前请复制本文件为 .env 并填入实际值。

# Teable 服务器地址
TEABLE_API_URL=https://your-teable-instance.example.com

# Teable 应用 Token（具有访问排课总台账权限）
TEABLE_APP_TOKEN=your_teable_app_token_here

# Teable Base ID（多维表格空间 ID）
TEABLE_BASE_ID=your_teable_base_id_here

# Teable Table ID（排课总台账的表 ID）
TEABLE_TABLE_ID=your_teable_table_id_here

# 可选：当前应用 ID（用于应用切换器）
TEABLE_APP_ID=your_teable_app_id_here
